<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/scrollCloud"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg"
    android:clipToPadding="false"
    android:focusable="true"
    android:focusableInTouchMode="true"
    android:fillViewport="true"
    android:overScrollMode="never">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="18dp"
        android:paddingTop="12dp"
        android:paddingEnd="18dp"
        android:paddingBottom="32dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tvCloudBack"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="?attr/selectableItemBackground"
                android:clickable="true"
                android:focusable="true"
                android:paddingTop="6dp"
                android:paddingEnd="12dp"
                android:paddingBottom="6dp"
                android:text="@string/cloud_back"
                android:textColor="@color/text_secondary"
                android:textSize="13sp" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/cloud_title"
                android:textColor="@color/text_primary"
                android:textSize="23sp"
                android:textStyle="bold" />
        </LinearLayout>

        <TextView
            style="@style/Hint"
            android:layout_marginTop="2dp"
            android:layout_marginBottom="14dp"
            android:text="@string/cloud_page_subtitle" />

        <LinearLayout
            android:id="@+id/cardProfile"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_cloud_hero"
            android:elevation="3dp"
            android:orientation="vertical"
            android:padding="18dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <FrameLayout
                    android:layout_width="66dp"
                    android:layout_height="66dp"
                    android:background="@drawable/bg_avatar_outer"
                    android:padding="4dp">

                    <TextView
                        android:id="@+id/tvAvatarInitial"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:background="@drawable/bg_avatar_inner"
                        android:gravity="center"
                        android:text="@string/cloud_avatar_guest"
                        android:textColor="@color/on_accent"
                        android:textSize="24sp"
                        android:textStyle="bold" />
                </FrameLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="14dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            android:id="@+id/tvProfileName"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:ellipsize="end"
                            android:maxLines="1"
                            android:text="@string/cloud_profile_guest"
                            android:textColor="#FFFFFFFF"
                            android:textSize="20sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/tvProfileStatus"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="8dp"
                            android:background="@drawable/bg_hero_chip"
                            android:paddingStart="9dp"
                            android:paddingTop="3dp"
                            android:paddingEnd="9dp"
                            android:paddingBottom="3dp"
                            android:text="@string/cloud_status_local"
                            android:textColor="#CCFFFFFF"
                            android:textSize="11sp" />
                    </LinearLayout>

                    <TextView
                        android:id="@+id/tvProfileMeta"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:ellipsize="end"
                        android:maxLines="1"
                        android:text="@string/cloud_profile_guest_meta"
                        android:textColor="#CCFFFFFF"
                        android:textSize="12sp" />

                    <TextView
                        android:id="@+id/tvProfileId"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="3dp"
                        android:ellipsize="end"
                        android:maxLines="1"
                        android:text="@string/cloud_profile_id_empty"
                        android:textColor="#99FFFFFF"
                        android:textSize="11sp" />
                </LinearLayout>

                <TextView
                    android:id="@+id/chipProfileAction"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_hero_chip"
                    android:clickable="true"
                    android:focusable="true"
                    android:paddingStart="13dp"
                    android:paddingTop="8dp"
                    android:paddingEnd="13dp"
                    android:paddingBottom="8dp"
                    android:text="@string/cloud_profile_action_login"
                    android:textColor="#FFFFFFFF"
                    android:textSize="12sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <TextView
                android:id="@+id/tvProfileHint"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="@string/cloud_profile_hint"
                android:textColor="#B3FFFFFF"
                android:textSize="11sp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/cardLogin"
            style="@style/Card"
            android:layout_marginTop="14dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/cloud_login_title"
                android:textColor="@color/text_primary"
                android:textSize="17sp"
                android:textStyle="bold" />

            <TextView
                style="@style/Hint"
                android:layout_marginTop="3dp"
                android:layout_marginBottom="12dp"
                android:text="@string/cloud_login_desc" />

            <EditText
                android:id="@+id/etCloudEmail"
                style="@style/Input"
                android:autofillHints="emailAddress"
                android:hint="@string/cloud_email_hint"
                android:inputType="textEmailAddress"
                android:maxLines="1" />

            <EditText
                android:id="@+id/etCloudPassword"
                style="@style/Input"
                android:layout_marginTop="8dp"
                android:autofillHints="password"
                android:hint="@string/cloud_password_hint"
                android:inputType="textPassword"
                android:maxLines="1" />

            <EditText
                android:id="@+id/etCloudName"
                style="@style/Input"
                android:layout_marginTop="8dp"
                android:autofillHints="name"
                android:hint="@string/cloud_name_hint"
                android:inputType="text"
                android:maxLength="20"
                android:maxLines="1" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/chipCloudLogin"
                    style="@style/ChipInline"
                    android:background="@drawable/bg_primary_small"
                    android:paddingStart="26dp"
                    android:paddingEnd="26dp"
                    android:text="@string/cloud_login"
                    android:textColor="@color/on_accent"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/chipCloudRegister"
                    style="@style/ChipInline"
                    android:layout_marginStart="8dp"
                    android:paddingStart="26dp"
                    android:paddingEnd="26dp"
                    android:text="@string/cloud_register" />
            </LinearLayout>

            <TextView
                android:id="@+id/chipCloudRecover"
                style="@style/ChipInline"
                android:layout_marginTop="8dp"
                android:text="@string/cloud_recover" />

            <TextView
                style="@style/Hint"
                android:layout_marginTop="14dp"
                android:text="@string/cloud_server_label" />

            <EditText
                android:id="@+id/etCloudServer"
                style="@style/Input"
                android:layout_marginTop="6dp"
                android:hint="@string/cloud_server_hint"
                android:inputType="textUri"
                android:maxLines="1" />

            <TextView
                android:id="@+id/tvCloudSecure"
                style="@style/Hint"
                android:layout_marginTop="10dp"
                android:text="@string/cloud_secure_hint" />
        </LinearLayout>

        <TextView
            style="@style/SectionLabel"
            android:text="@string/cloud_pair_section" />

        <LinearLayout
            android:id="@+id/cardPair"
            style="@style/Card">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <FrameLayout
                    android:layout_width="50dp"
                    android:layout_height="50dp"
                    android:background="@drawable/bg_partner_avatar">

                    <TextView
                        android:id="@+id/tvPartnerAvatar"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:gravity="center"
                        android:text="@string/cloud_partner_avatar"
                        android:textColor="@color/accent"
                        android:textSize="18sp"
                        android:textStyle="bold" />
                </FrameLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/tvPartnerName"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:ellipsize="end"
                        android:maxLines="1"
                        android:text="@string/cloud_partner_empty"
                        android:textColor="@color/text_primary"
                        android:textSize="16sp"
                        android:textStyle="bold" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <View
                            android:id="@+id/viewPartnerDot"
                            android:layout_width="7dp"
                            android:layout_height="7dp"
                            android:layout_marginEnd="6dp"
                            android:background="@drawable/bg_online_dot"
                            android:visibility="gone" />

                        <TextView
                            android:id="@+id/tvPartnerOnline"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:ellipsize="end"
                            android:maxLines="1"
                            android:text="@string/cloud_partner_offline"
                            android:textColor="@color/text_secondary"
                            android:textSize="11sp" />
                    </LinearLayout>

                    <TextView
                        android:id="@+id/tvPartnerId"
                        style="@style/Hint"
                        android:layout_marginTop="2dp"
                        android:text="@string/cloud_partner_id_empty" />
                </LinearLayout>

                <TextView
                    android:id="@+id/tvPairState"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_pair_state"
                    android:paddingStart="9dp"
                    android:paddingTop="4dp"
                    android:paddingEnd="9dp"
                    android:paddingBottom="4dp"
                    android:text="@string/cloud_pair_state_empty"
                    android:textColor="@color/accent"
                    android:textSize="11sp" />
            </LinearLayout>

            <TextView
                android:id="@+id/tvPairStatus"
                style="@style/Hint"
                android:layout_marginTop="12dp"
                android:text="@string/cloud_pair_need_login" />

            <TextView
                android:id="@+id/tvTogetherDays"
                style="@style/Hint"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:background="@drawable/bg_together_pill"
                android:drawableStart="@drawable/ic_cloud_heart"
                android:drawablePadding="6dp"
                android:drawableTint="@color/accent"
                android:gravity="center_vertical"
                android:paddingStart="10dp"
                android:paddingTop="6dp"
                android:paddingEnd="12dp"
                android:paddingBottom="6dp"
                android:textColor="@color/accent"
                android:textSize="12sp"
                android:textStyle="bold"
                android:visibility="gone"
                tools:text="云端相伴第 12 天" />

            <TextView
                android:id="@+id/tvPairCode"
                style="@style/RowValue"
                android:layout_marginTop="8dp"
                android:letterSpacing="0.18"
                android:textSize="24sp"
                android:visibility="gone" />

            <TextView
                android:id="@+id/tvPairCodeHint"
                style="@style/Hint"
                android:layout_marginTop="2dp"
                android:text="@string/cloud_pair_code_hint"
                android:visibility="gone" />

            <TextView
                android:id="@+id/chipCloudCreateCode"
                style="@style/ChipInline"
                android:layout_marginTop="10dp"
                android:text="@string/cloud_create_code" />

            <EditText
                android:id="@+id/etPairCode"
                style="@style/Input"
                android:layout_marginTop="10dp"
                android:hint="@string/cloud_pair_input_hint"
                android:inputType="number"
                android:maxLength="6"
                android:maxLines="1" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/chipCloudJoin"
                    style="@style/ChipInline"
                    android:background="@drawable/bg_primary_small"
                    android:paddingStart="20dp"
                    android:paddingEnd="20dp"
                    android:text="@string/cloud_join"
                    android:textColor="@color/on_accent"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/chipCloudUnpair"
                    style="@style/ChipInline"
                    android:layout_marginStart="8dp"
                    android:text="@string/cloud_unpair"
                    android:visibility="gone" />
            </LinearLayout>

            <TextView
                android:id="@+id/tvPairError"
                style="@style/Hint"
                android:layout_marginTop="8dp"
                android:textColor="@color/accent"
                android:visibility="gone" />
        </LinearLayout>

        <TextView
            style="@style/SectionLabel"
            android:text="@string/cloud_partner_section" />

        <LinearLayout
            android:id="@+id/cardPartner"
            style="@style/Card">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/cloud_partner_status_title"
                    android:textColor="@color/text_primary"
                    android:textSize="15sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvPartnerAt"
                    style="@style/Hint"
                    android:layout_width="wrap_content"
                    android:text="@string/cloud_status_empty"
                    android:textSize="11sp" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:orientation="horizontal">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="6dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_status_tile"
                    android:orientation="vertical"
                    android:padding="12dp">

                    <TextView
                        style="@style/RowLabel"
                        android:text="@string/cloud_battery"
                        android:textSize="11sp"
                        android:textColor="@color/text_secondary" />

                    <TextView
                        android:id="@+id/tvPartnerBattery"
                        style="@style/RowValue"
                        android:layout_marginTop="4dp"
                        android:text="@string/cloud_unknown"
                        android:textSize="18sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_status_tile"
                    android:orientation="vertical"
                    android:padding="12dp">

                    <TextView
                        style="@style/RowLabel"
                        android:text="@string/cloud_charging"
                        android:textSize="11sp"
                        android:textColor="@color/text_secondary" />

                    <TextView
                        android:id="@+id/tvPartnerCharging"
                        style="@style/RowValue"
                        android:layout_marginTop="4dp"
                        android:text="@string/cloud_unknown"
                        android:textSize="18sp"
                        android:textStyle="bold" />
                </LinearLayout>
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:orientation="horizontal">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="6dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_status_tile"
                    android:orientation="vertical"
                    android:padding="12dp">

                    <TextView
                        style="@style/RowLabel"
                        android:text="@string/cloud_network"
                        android:textSize="11sp"
                        android:textColor="@color/text_secondary" />

                    <TextView
                        android:id="@+id/tvPartnerNetwork"
                        style="@style/RowValue"
                        android:layout_marginTop="4dp"
                        android:text="@string/cloud_unknown"
                        android:textSize="18sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_status_tile"
                    android:orientation="vertical"
                    android:padding="12dp">

                    <TextView
                        style="@style/RowLabel"
                        android:text="@string/cloud_heating"
                        android:textSize="11sp"
                        android:textColor="@color/text_secondary" />

                    <TextView
                        android:id="@+id/tvPartnerHeating"
                        style="@style/RowValue"
                        android:layout_marginTop="4dp"
                        android:text="@string/cloud_unknown"
                        android:textSize="18sp"
                        android:textStyle="bold" />
                </LinearLayout>
            </LinearLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginTop="14dp"
                android:layout_marginBottom="10dp"
                android:background="@color/divider" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        style="@style/RowLabel"
                        android:text="@string/cloud_share_title" />

                    <TextView
                        style="@style/Hint"
                        android:text="@string/cloud_share_desc" />
                </LinearLayout>

                <androidx.appcompat.widget.SwitchCompat
                    android:id="@+id/switchCloudShare"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content" />
            </LinearLayout>

            <TextView
                android:id="@+id/tvCloudShareState"
                style="@style/Hint"
                android:layout_marginTop="6dp"
                android:text="@string/cloud_share_off" />
        </LinearLayout>

        <TextView
            style="@style/SectionLabel"
            android:text="@string/cloud_remind_section" />

        <LinearLayout
            android:id="@+id/cardInteract"
            style="@style/Card">

            <TextView
                android:id="@+id/tvInteractHint"
                style="@style/Hint"
                android:text="@string/cloud_interact_hint" />

            <TextView
                android:id="@+id/tvNudgeGroup"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:letterSpacing="0.08"
                android:text="@string/cloud_nudge_group"
                android:textColor="@color/text_secondary"
                android:textSize="11sp"
                android:textStyle="bold" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/chipCloudNudgeSleep"
                    style="@style/Chip"
                    android:text="@string/cloud_nudge_sleep" />

                <TextView
                    android:id="@+id/chipCloudNudgeWater"
                    style="@style/Chip"
                    android:layout_marginStart="8dp"
                    android:text="@string/cloud_nudge_water" />
            </LinearLayout>

            <TextView
                android:id="@+id/tvAffectionGroup"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:letterSpacing="0.08"
                android:text="@string/cloud_affection_group"
                android:textColor="@color/accent"
                android:textSize="11sp"
                android:textStyle="bold" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/chipCloudMiss"
                    style="@style/Chip"
                    android:background="@drawable/bg_affection_chip"
                    android:drawableStart="@drawable/ic_cloud_heart"
                    android:drawableTint="@color/accent"
                    android:text="@string/cloud_affection_miss"
                    android:textColor="@color/accent" />

                <TextView
                    android:id="@+id/chipCloudHug"
                    style="@style/Chip"
                    android:layout_marginStart="8dp"
                    android:background="@drawable/bg_affection_chip"
                    android:drawableStart="@drawable/ic_cloud_heart"
                    android:drawableTint="@color/accent"
                    android:text="@string/cloud_affection_hug"
                    android:textColor="@color/accent" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/chipCloudKiss"
                    style="@style/Chip"
                    android:background="@drawable/bg_affection_chip"
                    android:drawableStart="@drawable/ic_cloud_heart"
                    android:drawableTint="@color/accent"
                    android:text="@string/cloud_affection_kiss"
                    android:textColor="@color/accent" />

                <TextView
                    android:id="@+id/chipCloudNight"
                    style="@style/Chip"
                    android:layout_marginStart="8dp"
                    android:background="@drawable/bg_affection_chip"
                    android:drawableStart="@drawable/ic_cloud_heart"
                    android:drawableTint="@color/accent"
                    android:text="@string/cloud_affection_night"
                    android:textColor="@color/accent" />
            </LinearLayout>

            <TextView
                android:id="@+id/tvDmGroup"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:letterSpacing="0.08"
                android:text="@string/cloud_dm_group"
                android:textColor="@color/text_secondary"
                android:textSize="11sp"
                android:textStyle="bold" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <EditText
                    android:id="@+id/etCloudDm"
                    style="@style/Input"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:hint="@string/cloud_dm_hint"
                    android:imeOptions="actionSend"
                    android:inputType="text"
                    android:maxLength="200"
                    android:maxLines="1" />

                <TextView
                    android:id="@+id/chipCloudDmSend"
                    style="@style/ChipInline"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:background="@drawable/bg_primary_small"
                    android:gravity="center"
                    android:minHeight="44dp"
                    android:paddingStart="18dp"
                    android:paddingEnd="18dp"
                    android:text="@string/cloud_dm_send"
                    android:textColor="@color/on_accent"
                    android:textStyle="bold" />
            </LinearLayout>

            <TextView
                android:id="@+id/tvCloudFeed"
                style="@style/Hint"
                android:layout_marginTop="12dp"
                android:background="@drawable/bg_feed"
                android:minHeight="48dp"
                android:padding="12dp"
                android:text="@string/cloud_feed_empty" />
        </LinearLayout>

        <TextView
            style="@style/SectionLabel"
            android:text="@string/cloud_more_section" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_card"
            android:elevation="1dp"
            android:orientation="vertical"
            android:padding="6dp">

            <LinearLayout
                android:id="@+id/rowAccount"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="?attr/selectableItemBackground"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:padding="12dp">

                <ImageView
                    android:layout_width="38dp"
                    android:layout_height="38dp"
                    android:background="@drawable/bg_menu_icon"
                    android:contentDescription="@string/cloud_menu_account"
                    android:padding="7dp"
                    android:src="@drawable/ic_cloud_shield" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/cloud_menu_account"
                        android:textColor="@color/text_primary"
                        android:textSize="14sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tvAccountMenuHint"
                        style="@style/Hint"
                        android:layout_marginTop="2dp"
                        android:text="@string/cloud_menu_account_desc" />
                </LinearLayout>

                <ImageView
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_cloud_chevron" />
            </LinearLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginStart="62dp"
                android:layout_marginEnd="12dp"
                android:background="@color/divider" />

            <LinearLayout
                android:id="@+id/rowCare"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="?attr/selectableItemBackground"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:padding="12dp">

                <ImageView
                    android:layout_width="38dp"
                    android:layout_height="38dp"
                    android:background="@drawable/bg_menu_icon"
                    android:contentDescription="@string/cloud_care"
                    android:padding="7dp"
                    android:src="@drawable/ic_cloud_bell" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/cloud_care"
                        android:textColor="@color/text_primary"
                        android:textSize="14sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tvCareHint"
                        style="@style/Hint"
                        android:layout_marginTop="2dp"
                        android:text="@string/cloud_care_desc" />
                </LinearLayout>

                <ImageView
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_cloud_chevron" />
            </LinearLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginStart="62dp"
                android:layout_marginEnd="12dp"
                android:background="@color/divider" />

            <LinearLayout
                android:id="@+id/rowAbout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="?attr/selectableItemBackground"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:padding="12dp">

                <ImageView
                    android:layout_width="38dp"
                    android:layout_height="38dp"
                    android:background="@drawable/bg_menu_icon"
                    android:contentDescription="@string/cloud_about"
                    android:padding="7dp"
                    android:src="@drawable/ic_cloud_info" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/cloud_about"
                        android:textColor="@color/text_primary"
                        android:textSize="14sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tvAboutHint"
                        style="@style/Hint"
                        android:layout_marginTop="2dp"
                        android:text="@string/cloud_about_desc" />
                </LinearLayout>

                <ImageView
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_cloud_chevron" />
            </LinearLayout>
        </LinearLayout>

        <TextView
            style="@style/Hint"
            android:layout_marginTop="16dp"
            android:text="@string/cloud_boundary" />
    </LinearLayout>
</ScrollView>
