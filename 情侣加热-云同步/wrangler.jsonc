{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "hotwinter-cloud",
  "main": "src/index.js",
  "compatibility_date": "2025-09-01",
  "workers_dev": true,

  "observability": {
    "enabled": true
  },

  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "hotwinter-cloud",
      "database_id": "d3c0ef63-cc3d-43dc-9b64-b664f71b4055",
      "migrations_dir": "migrations"
    }
  ],

  "durable_objects": {
    "bindings": [
      {
        "name": "COUPLE_ROOM",
        "class_name": "CoupleRoom"
      }
    ]
  },

  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["CoupleRoom"]
    }
  ]
}
